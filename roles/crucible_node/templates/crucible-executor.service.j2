# Managed by Ansible — CRUCIBLE executor on {{ inventory_hostname }}
[Unit]
Description=CRUCIBLE parallel build executor node
After=docker.service
Requires=docker.service

[Service]
Type=simple
User={{ jetson_user }}
Environment=CRUCIBLE_PORT={{ crucible_port }}
ExecStart=/usr/bin/python3 {{ crucible_dir }}/executor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
